<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tableau de bord — Division Vanguard</title>
<style>
:root { --fond:#14161a; --carte:#1e2126; --bord:#2c3138; --accent:#2b3a55; --accent2:#34568b; --texte:#e6e8ea; --sourd:#8b929b; }
* { box-sizing:border-box; }
body { margin:0; background:var(--fond); color:var(--texte); font-family:'Segoe UI',system-ui,sans-serif; }
header { background:var(--accent); padding:18px 32px; display:flex; justify-content:space-between; align-items:center; }
header h1 { margin:0; font-size:17px; letter-spacing:1.5px; text-transform:uppercase; }
.sortie { background:#8b1a1a; color:#fff; padding:9px 18px; border-radius:4px; text-decoration:none; font-size:14px; font-weight:600; }
.grille { max-width:1150px; margin:32px auto; padding:0 20px; display:grid; grid-template-columns:320px 1fr; gap:24px; }
@media (max-width:860px) { .grille { grid-template-columns:1fr; } }
.carte { background:var(--carte); border:1px solid var(--bord); border-left:3px solid var(--accent2); border-radius:6px; padding:24px; }
.carte h2 { margin:0 0 18px; font-size:14px; letter-spacing:1.2px; text-transform:uppercase; color:var(--sourd); }
.profil { text-align:center; }
.avatar { width:110px; height:110px; border-radius:50%; border:2px solid var(--accent2); }
.nom { margin-top:14px; font-size:19px; font-weight:600; }
.ident { color:var(--sourd); font-size:12px; margin-top:4px; word-break:break-all; }
.roles { margin-top:22px; text-align:left; }
.role { display:inline-block; padding:5px 10px; margin:3px 3px 3px 0; border-radius:3px;
        background:#15181c; border-left:3px solid #444; font-size:12px; }
.stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.stat { background:#15181c; border:1px solid var(--bord); border-radius:5px; padding:16px; text-align:center; }
.stat b { display:block; font-size:24px; color:var(--accent2); }
.stat span { font-size:11px; color:var(--sourd); text-transform:uppercase; letter-spacing:1px; }
.ligne { display:flex; justify-content:space-between; padding:11px 0; border-bottom:1px solid var(--bord); font-size:14px; }
.ligne:last-child { border-bottom:none; }
.ligne span:first-child { color:var(--sourd); }
.ok { color:#3ea55f; font-weight:600; }
</style>
</head>
<body>
<header>
    <h1>Division Vanguard — Portail interne</h1>
    <a class="sortie" href="/logout">Déconnexion</a>
</header>

<div class="grille">
    <div class="carte profil">
        <img class="avatar" src="<%= user.avatarURL %>" alt="Avatar">
        <div class="nom"><%= user.username %></div>
        <div class="ident"><%= user.id %></div>
        <div class="roles">
            <h2>Grades et rôles</h2>
            <% if (roles.length) { %>
                <% roles.forEach(function(role) { %>
                    <span class="role" style="border-left-color:<%= role.color %>;"><%= role.name %></span>
                <% }); %>
            <% } else { %>
                <p style="color:var(--sourd);font-size:13px;">Aucun rôle attribué.</p>
            <% } %>
        </div>
    </div>

    <div class="carte">
        <h2>État du serveur</h2>
        <div class="stats">
            <div class="stat"><b><%= guild.memberCount %></b><span>Membres</span></div>
            <div class="stat"><b><%= guild.boostLevel %></b><span>Niveau boost</span></div>
            <div class="stat"><b><%= guild.boostCount %></b><span>Boosts</span></div>
        </div>
        <div style="margin-top:20px;">
            <div class="ligne"><span>Serveur</span><span><%= guild.name %></span></div>
            <div class="ligne"><span>Service Discord</span><span class="ok">Opérationnel</span></div>
            <div class="ligne"><span>Portail web</span><span class="ok">Opérationnel</span></div>
        </div>
    </div>
</div>
</body>
</html>
